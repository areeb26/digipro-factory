# ==========================================
# Digital Product Factory - Environment Variables
# ==========================================
# IMPORTANT: Copy this file to .env and fill in your actual values
# Never commit the .env file to version control!

# ==========================================
# AI API Keys
# ==========================================

# Anthropic Claude API Key
# Get your API key from: https://console.anthropic.com/
# Used for: AI-powered content generation, product descriptions, marketing copy
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# Google Gemini API Key
# Get your API key from: https://makersuite.google.com/app/apikey
# Used for: AI content generation, image analysis, trend insights
GEMINI_API_KEY=your_gemini_api_key_here

# OpenAI API Key (Optional)
# Get your API key from: https://platform.openai.com/api-keys
# Used for: Alternative AI content generation (GPT-4)
# Note: This is optional - the system will work with just Claude or Gemini
OPENAI_API_KEY=your_openai_api_key_here

# ==========================================
# Etsy Integration
# ==========================================

# Etsy OAuth Credentials
# Get these from: https://www.etsy.com/developers/your-apps
# Required for: Publishing products to Etsy, managing listings

# Your Etsy App's Client ID (also called API Key)
ETSY_CLIENT_ID=your_etsy_client_id_here

# Your Etsy App's Client Secret (also called Shared Secret)
ETSY_CLIENT_SECRET=your_etsy_client_secret_here

# Your Etsy Shop ID (numeric ID, found in your shop URL or account settings)
# Example: If your shop URL is etsy.com/shop/YourShop, find the shop_id in account settings
ETSY_SHOP_ID=your_etsy_shop_id_here

# OAuth Redirect URI (default: http://localhost:8080/callback)
# Must match the redirect URI configured in your Etsy App settings
ETSY_REDIRECT_URI=http://localhost:8080/callback

# Etsy OAuth Access Token (generated after OAuth flow)
# This will be automatically generated after first authentication
ETSY_ACCESS_TOKEN=

# Etsy OAuth Refresh Token (for refreshing expired access tokens)
# Automatically saved after OAuth flow
ETSY_REFRESH_TOKEN=

# Token expiration timestamp (ISO format)
# Automatically updated when token is refreshed
ETSY_TOKEN_EXPIRES_AT=

# ==========================================
# Gumroad Integration
# ==========================================

# Gumroad Access Token
# Get this from: https://app.gumroad.com/settings/advanced#application-form
# Required for: Publishing products to Gumroad, managing products
GUMROAD_ACCESS_TOKEN=your_gumroad_access_token_here

# ==========================================
# Database Configuration
# ==========================================

# SQLite Database Path (relative to project root)
# Default: data/products.db (SQLite doesn't require separate server)
DATABASE_PATH=data/products.db

# For future PostgreSQL/MySQL support (optional)
# DATABASE_URL=postgresql://user:password@localhost:5432/dbname
# DATABASE_URL=mysql://user:password@localhost:3306/dbname

# ==========================================
# Application Settings
# ==========================================

# Flask Settings
# Environment: development, production, testing
FLASK_ENV=development

# Flask Secret Key (generate with: python -c "import secrets; print(secrets.token_hex(32))")
# Used for: Session management, CSRF protection
FLASK_SECRET_KEY=your_flask_secret_key_here

# Flask Debug Mode (set to False in production)
FLASK_DEBUG=True

# Application Host and Port
APP_HOST=0.0.0.0
APP_PORT=5000

# ==========================================
# Optional: Proxy Settings (if behind corporate firewall)
# ==========================================

# HTTP_PROXY=http://proxy.example.com:8080
# HTTPS_PROXY=https://proxy.example.com:8080

# ==========================================
# Optional: Logging Configuration
# ==========================================

# Log Level: DEBUG, INFO, WARNING, ERROR, CRITICAL
LOG_LEVEL=INFO

# Log File Path
LOG_FILE=logs/app.log
